---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { SITE_URL, OG_IMAGE } from '../../../consts';
import { getPosts, postPath, formatDate } from '../../../posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, image, imageAlt } = post.data;
const path = postPath(post.id);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  image: image ? SITE_URL + image : OG_IMAGE,
  mainEntityOfPage: SITE_URL + path,
  author: { '@type': 'Organization', name: 'SKY Cabinet Kitchen & Bath', url: `${SITE_URL}/` },
  publisher: { '@id': `${SITE_URL}/#business` },
};
---
<Base title={`${title} | SKY Cabinet`} description={description} path={path} ogType="article" schema={[articleSchema]}>
<section class="page-head"><div class="wrap">
  <a class="eyebrow" href="/blog/">Blog</a>
  <h1>{title}</h1>
  <p class="post-meta">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {updatedDate && <span> · Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>}
  </p>
</div></section>
<div class="wrap"><article class="legal-doc post-body">
  {image && <img src={image} alt={imageAlt ?? ''} loading="eager" decoding="async">}
  <Content />
  <aside class="post-cta">
    <h2>See it in person</h2>
    <p>Visit our Norfolk showroom at 3101 Lafayette Blvd, borrow up to 3 door samples free for 7 days, or get a free 3D design and written quote.</p>
    <p><a class="btn primary" href="/#contact">Get my free 3D design</a> <a class="btn ghost" href="tel:+17577979004">Call (757) 797-9004</a></p>
  </aside>
</article></div>
</Base>
